{
  "name": "@netivo/plugins-repository",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized Cloudflare R2 and CDN repository configuration for Netivo WordPress plugins",
  "scripts": {
    "test": "node scripts/validate.js",
