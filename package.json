    "worker:dev": "pnpm --prefix worker run dev",
    "worker:deploy": "pnpm --prefix worker run deploy"
  },
  "keywords": [
    "wordpress",
    "cloudflare-r2",
    "plugin-repository",
    "updates"
  ],
